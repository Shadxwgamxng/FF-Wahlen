# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ff_wahlen?schema=public"

# Öffentliche URL der Anwendung (für den Discord-Redirect)
APP_URL="http://localhost:3000"

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect-URI: {APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Komma-getrennte Discord-IDs, die beim ersten Login automatisch Superadministrator werden
SUPERADMIN_DISCORD_IDS=""

# Optionales Secret für /api/cron/tick (Bearer-Token)
CRON_SECRET=""

# NUR für lokale Entwicklung: Login ohne Discord (wird in Produktion ignoriert)
DEV_LOGIN="false"
