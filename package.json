{
  "name": "ff-wahlen",
  "version": "1.0.0",
  "private": true,
  "description": "Wahlplattform für eine Freiwillige Feuerwehr (FiveM Roleplay)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
